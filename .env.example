# --- Public site URL (set per-environment) ---
NEXT_PUBLIC_SITE_URL=https://assess.cyrvana.com

# --- Supabase (from your Supabase project: Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# SERVICE ROLE KEY: server-only. Never expose to the client. Used by Server Actions
# and Edge Functions to write leads/sessions while bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Termly consent banner ---
# Paste the website-UUID from app.termly.io → Consent Management → Consent Banner → Install → Embed.
# See docs/DEPLOYMENT.md for the full setup walk-through.
NEXT_PUBLIC_TERMLY_UUID=

# --- Destination secrets (Phase 2+) ---
# Symmetric key used to encrypt destination credentials at rest (e.g. HubSpot Private App tokens).
# Generate with: openssl rand -base64 32
DESTINATION_SECRETS_KEY=

# --- Claude API (Phase 3 / v2 — AI-personalized results) ---
ANTHROPIC_API_KEY=

# --- ZeptoMail (Phase 2 — transactional email of results) ---
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER=results@assess.cyrvana.com
